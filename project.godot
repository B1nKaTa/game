config_version=5

[application]

config/name="Grandpa"
config/version="0.5.0"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/boot.tscn"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Sounds="*res://scripts/autoload/sounds.gd"
Progress="*res://scripts/autoload/progress.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.05, 1)
