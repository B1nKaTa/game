class_name PixelGlyphs
extends RefCounted

# Two hand-made block fonts for the title screen's signs, drawn on the room's own pixel grid: BIG (5x7)
# for the plaque's name, SMALL (3x5) for its subtitle, the NOW SERVING board and the TAKE 1 sign. Each
# glyph is rows of '#' (lit) and '.' (unlit). Letters are upper case only; a lower case letter is drawn
# as its capital, and a character with no glyph as a space.

