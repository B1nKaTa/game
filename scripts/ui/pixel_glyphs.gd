static func glyph(font: Dictionary, character: String) -> Array:
	var key := character.to_upper()
	return font.get(key, [])


static func glyph_width(font: Dictionary) -> int:
	return str(font["A"][0]).length()


static func glyph_height(font: Dictionary) -> int:
	return font["A"].size()


# Width of text in font cells: each glyph and a one-cell gap between glyphs.
static func text_width(font: Dictionary, text: String) -> int:
	if text.is_empty():
		return 0
	return text.length() * (glyph_width(font) + 1) - 1


# Every lit cell of text, as cell positions from its top-left.
static func cells(font: Dictionary, text: String) -> Array[Vector2i]:
	var out: Array[Vector2i] = []
	var step := glyph_width(font) + 1
	for i in text.length():
		var rows := glyph(font, text[i])
		for y in rows.size():
			var row := str(rows[y])
			for x in row.length():
				if row[x] == "#":
					out.append(Vector2i(i * step + x, y))
	return out


# Draws text with each lit cell as a cell x cell square at at (its top-left).
static func draw_text(canvas: CanvasItem, font: Dictionary, text: String, at: Vector2, color: Color, cell := 1.0) -> void:
	for c in cells(font, text):
		canvas.draw_rect(Rect2(at + Vector2(c) * cell, Vector2(cell, cell)), color)
